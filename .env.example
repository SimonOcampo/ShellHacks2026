# Local startup defaults to mock until a verified release is built.
ODD_DATA_MODE=mock
ODD_DATA_RELEASE=data/releases/mock.v1.json
ODD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Copy frontend variables to apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DATA_TRANSPORT=http
# Ingestion only; never expose these in frontend variables.
CENSUS_API_KEY=
AFDC_API_KEY=
# Reserved for P1; P0 does not call an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=
